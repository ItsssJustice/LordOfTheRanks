{
    "discord_members": {
        "discord_id": "BIGINT PRIMARY KEY",
        "name_user": "VARCHAR(255) NOT NULL",
        "name_global": "VARCHAR(255) NOT NULL",
        "name_display": "VARCHAR(255) NOT NULL",
        "name_nick": "VARCHAR(255) NOT NULL",
        "discriminator": "INT",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
    },

    "discord_roles": {
        "discord_role_id": "BIGINT PRIMARY KEY",
        "discord_role_name": "VARCHAR(255)"
    },

    "osrs_clan_members": {
    	"player_id": "BIGINT PRIMARY KEY",
    	"current_rsn": "VARCHAR(255) NOT NULL",
    	"rank_id": "INT NOT NULL",
    	"join_date": "DATETIME NOT NULL",
    	"leave_date": "DATETIME",
    	"current_member": "BOOLEAN NOT NULL DEFAULT FALSE",
    	"created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
    	"updated_at": "DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"
    },

    "discord_osrs_link": {
	   "link_id": "INT PRIMARY KEY AUTO_INCREMENT",
        "discord_id": "BIGINT",
        "player_id": "INT NOT NULL",
        "is_main_account": "BOOLEAN NOT NULL DEFAULT FALSE"
    },

    "competitions": {
        "competition_id": "INT PRIMARY KEY",
        "title": "VARCHAR(255) NOT NULL",
        "starts_at": "DATETIME NOT NULL",
        "ends_at": "DATETIME NOT NULL",
        "metric": "VARCHAR(100) NOT NULL",
        "points_assigned": "BOOLEAN NOT NULL DEFAULT FALSE",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
        "updated_at": "DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"
    },

    "points_sources": {
        "source_id": "INT PRIMARY KEY AUTO_INCREMENT",
        "source_description": "VARCHAR(255)"
    },

    "points_values": {
        "points_id": "INT PRIMARY KEY AUTO_INCREMENT",
        "source_id": "INT NOT NULL",
        "contribution_level": "INT NOT NULL DEFAULT 0",
        "points": "INT NOT NULL",
    },

    "points_tokens": {
        "token_id": "INT PRIMARY KEY AUTO_INCREMENT",
        "source_id": "INT NOT NULL",
        "created_by_discord_id": "BIGINT NOT NULL",
        "manual_assignment": "BOOLEAN NOT NULL DEFAULT FALSE",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP"
    },

    "point_transactions": {
    	"transaction_id": "INT PRIMARY KEY AUTO_INCREMENT",
    	"discord_id": "BIGINT NOT NULL",
    	"token_id": "INT NOT NULL",
        "points": "INT NOT NULL"
    },

    "promotion_polls": {
        "poll_id": "INT PRIMARY KEY AUTO_INCREMENT",
        "discord_id": "BIGINT NOT NULL",
        "player_id": "BIGINT NOT NULL",
        "created_by_discord_id": "BIGINT NULL",
        "vote_passed": "BOOLEAN DEFAULT FALSE",
        "vote_actioned": "BOOLEAN DEFAULT FALSE",
        "rank_previous": "INT NOT NULL",
        "rank_new": "INT NOT NULL",
        "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
        "closed_at": "DATETIME NULL"
    },

    "discord_promotion_ranks": {
        "promotion_rank_id": "INT PRIMARY KEY",
        "discord_role_id": "BIGINT NOT NULL",
        "points_required": "INT",
        "membership_time_required": "INT",
        "automatic_promotion": "BOOL DEFAULT FALSE",
        "promotion_rank_id_progression": "INT"
    },

    "discord_promotion_roles": {
        "link_id": "INT PRIMARY KEY AUTO_INCREMENT",
        "promotion_rank_id": "INT",
        "discord_role_id": "BIGINT",
    },

    "bot_config": {
        "config_id": "INT PRIMARY KEY AUTO_INCREMENT",
        "config_name": "VARCHAR(255) NOT NULL",
        "config_executed": "BIGINT DEFAULT 0",
        "config_update_time": "DATETIME DEFAULT CURRENT_TIMESTAMP"
    }
}